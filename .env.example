# Copie este archivo como .env (no versionado) y complete SOLO las credenciales que tenga.
# Nunca pegue claves en config/*.toml, en el código ni en la interfaz.
# La terminal funciona sin ninguna: FRED (tipo de cambio) no requiere clave.

# Tiingo — cierres diarios de EE. UU. (referencia de emisoras del SIC y ETF). Registro gratuito: https://www.tiingo.com
TIINGO_API_KEY=

# EODHD — cierres diarios de la BMV. Plan gratuito: 20 peticiones/día. https://eodhd.com
EODHD_API_KEY=

# Banco de México SIE — tipo de cambio FIX. Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Opcionales
# TERMINAL_MODO=demo            # datos SINTÉTICOS etiquetados (equivale a `uv run terminal demo`)
# TERMINAL_DATA_DIR=C:\ruta\a\datos
