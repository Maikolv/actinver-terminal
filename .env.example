# Copie este archivo como .env (no versionado) y complete SOLO las credenciales que tenga.
# Nunca pegue claves en config/*.toml, en el código ni en la interfaz.
# La terminal funciona sin ninguna: FRED (tipo de cambio) no requiere clave.

# FRED — API oficial (clave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html). Sin clave se intenta el CSV
# público de gráficas, que puede no responder a clientes automatizados.
FRED_API_KEY=

# Tiingo — cierres diarios de EE. UU. (referencia de emisoras del SIC y ETF). Registro gratuito: https://www.tiingo.com
TIINGO_API_KEY=

# EODHD — cierres diarios de la BMV. Plan gratuito: 20 peticiones/día. https://eodhd.com
EODHD_API_KEY=

# Banco de México SIE — tipo de cambio FIX. Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# SEC EDGAR — Formulario 4 (insiders). La SEC exige un User-Agent con contacto real; sin esto la fuente
# queda "requiere configuración" (no se inventa un valor). https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=

# Alpaca Market Data — SOLO datos (la terminal nunca llama la API de operaciones). Cuenta gratuita:
# https://alpaca.markets → Paper Trading (dinero ficticio) → API Keys. Plan gratuito: cierres diarios de EE. UU.
# y precio en vivo de IEX por WebSocket (1 conexión, 30 símbolos). Compruebe con: uv run terminal alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Proveedores contratados (sin contrato quedan «pendiente»; la terminal no inventa endpoints) -------------------
# Cada uno necesita: la especificación JSON copiada de la documentación de su contrato
# (plantilla: config/proveedores/ejemplo_especificacion.json), la URL base y la credencial.
# BMV_ESPECIFICACION=config/proveedores/bmv.json
# BMV_URL_BASE=
# BMV_API_KEY=
# Infosel Market API v3 (Infosel HUB): último hecho BMV y SIC en MXN. El conector ya conoce la API pública
# (/api/v3/instruments/last); solo necesita la URL que indique su contrato y el token JWT que le entregue Infosel.
# Entorno de pruebas: https://hub-market-qa.infosel-digitalfactory.com
# INFOSEL_URL_BASE=
# INFOSEL_API_KEY=
# INFOSEL_ESPECIFICACION=config/proveedores/infosel.json   (opcional: solo para corregir símbolos con mapa_simbolos)
# Edimex / EDI Financial: solo con acceso programático contratado
# EDIMEX_ESPECIFICACION=config/proveedores/edimex.json
# EDIMEX_URL_BASE=
# EDIMEX_API_KEY=
# LSEG_ESPECIFICACION=
# LSEG_URL_BASE=
# LSEG_API_KEY=
# ICE_ESPECIFICACION=
# ICE_URL_BASE=
# ICE_API_KEY=

# --- Webhook de TradingView (alertas que usted configura; eventos, no flujo de precios) ----------------------------
# Genere el secreto con: uv run terminal webhook-secreto
TRADINGVIEW_WEBHOOK_SECRETO=
# Solo si expone el webhook con un túnel HTTPS propio: dominio(s) del túnel separados por coma
# TRADINGVIEW_WEBHOOK_HOSTS=mi-tunel.example.com
# TRADINGVIEW_VERIFICAR_IP=1

# Barchart OnDemand — históricos (requiere contrato/licencia de Barchart; sin él la fuente queda "requiere contrato")
BARCHART_API_KEY=

# Alertas por correo (activar con [alertas] notificar_correo = true en config/local.toml)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERTAS_CORREO_DESTINO=

# Alertas por Telegram (activas por defecto cuando ambas variables existen).
# 1) En Telegram hable con @BotFather → /newbot → copie el token aquí.
# 2) Escriba «hola» a su bot nuevo y ejecute: uv run terminal telegram  (detecta y guarda TELEGRAM_CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionales
# TERMINAL_MODO=demo            # datos SINTÉTICOS etiquetados (equivale a `uv run terminal demo`)
# TERMINAL_DATA_DIR=C:\ruta\a\datos
# OLLAMA_URL=http://127.0.0.1:11434   # LLM local opcional para afinar sentimiento de titulares de alto impacto
# OLLAMA_MODELO=llama3.2               # el texto nunca sale del equipo
