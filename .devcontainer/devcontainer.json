{
  "name": "Help Quote Terminal",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user uv && uv sync --frozen && cp -n .env.example .env || true",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Terminal", "onAutoForward": "openBrowser" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": { "openFiles": ["docs/codespaces.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
