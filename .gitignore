# Entorno
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secretos y configuración local: nunca se versionan
.env
.env.*
!.env.example
config/local.toml

# Datos del usuario y de mercado (se regeneran o son personales)
data/*.db
data/*.db-*
data/respaldos/
data/reportes/
data/importaciones/
data/referencias/
data/logs/
data/demo/

# Material privado de auditoría (renders del PDF, descargas crudas)
_privado/
_renders/

# Informes crudos (Lighthouse incluye el token CSRF efímero de la página)
docs/evidencia/*.json
!docs/evidencia/experimento_indices_fred.json
!docs/evidencia/experimento_estrategias.json
!docs/evidencia/calidad_series.json
!docs/evidencia/busqueda_eval.json
!docs/evidencia/experimento_kronos.json

# Especificaciones de contratos de datos (pueden contener detalles del contrato): solo locales
config/proveedores/*.json
!config/proveedores/ejemplo_especificacion.json
!config/proveedores/eodhd_diferido.json

# Datos locales (base de datos, respaldos, reportes y documentos descargados): nunca al repositorio
data/
!config/proveedores/twelvedata_bmv.json
