.mesa-controles {display:flex; flex-wrap:wrap; gap:16px; align-items:end; margin:20px 0}
.mesa-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,450px),1fr)); gap:16px}
.mesa-panel {min-width:0; align-self:start}
.mesa-panel header {display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:12px}
.mesa-panel h2 {font-size:1rem; margin:0 auto 0 0}
.mesa-panel iframe {width:100%; height:490px; border:0; margin-top:12px; resize:vertical; min-height:250px; max-height:900px}
.mesa-panel form {display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px}
.mesa-panel input {width:100%;box-sizing:border-box}
.mesa-panel summary {cursor:pointer; padding:12px 0}
