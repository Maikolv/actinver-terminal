var panel = table.new(position.bottom_right, 1, 3)
if barstate.islast
    fallos = 0
    primero = -1
    for i = 0 to 531
        j = i * 8
        k = i * 4
        [v, tp, riesgo, cantidad] = calcular(str.tonumber(array.get(datos,j)), str.tonumber(array.get(datos,j+1)), str.tonumber(array.get(datos,j+2)), str.tonumber(array.get(datos,j+3)), str.tonumber(array.get(datos,j+4)), str.tonumber(array.get(datos,j+5)), str.tonumber(array.get(datos,j+6)))
        valido = str.tonumber(array.get(datos,j+7)) == 1 and v
        esperadoValido = str.tonumber(array.get(referencia,k)) == 1
        coincide = valido == esperadoValido
        if valido and esperadoValido
            coincide := coincide and math.abs(tp-str.tonumber(array.get(referencia,k+1))) <= 0.000000001 and math.abs(riesgo-str.tonumber(array.get(referencia,k+2))) <= 0.000000001 * math.max(1,math.abs(str.tonumber(array.get(referencia,k+2)))) and cantidad == str.tonumber(array.get(referencia,k+3))
        if not coincide
            fallos += 1
            if primero == -1
                primero := i
    table.cell(panel,0,0,"PRUEBA FIJA · SIN EJECUCIÓN",text_color=color.white,bgcolor=color.black)
    table.cell(panel,0,1,"532 casos · diferencias: " + str.tostring(fallos),text_color=color.white,bgcolor=color.black)
    table.cell(panel,0,2,"Primer índice distinto: " + str.tostring(primero),text_color=color.white,bgcolor=color.black)
