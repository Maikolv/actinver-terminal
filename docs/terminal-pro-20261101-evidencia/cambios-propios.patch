+
+/* ---------- Capa de terminal profesional (compartida por todas las áreas) ----------
+   Densidad y legibilidad de terminal financiera con identidad propia: negro y grises, texto blanco, rojo como acento.
+   Paleta de partida inspirada en OpenTerminal (ErTasselli, MIT); ningún recurso de marcas de terceros. */
+:root { --rejilla: color-mix(in srgb, var(--borde) 60%, transparent); }
+main h1, .cuaderno-intro h1 { font-family: var(--mono); font-size: 1.1rem; letter-spacing: .06em; text-transform: uppercase; color: var(--texto);
+  border-left: 3px solid var(--acento-grafico); padding-left: 10px; }
+main h2 { font-family: var(--mono); font-size: .86rem; letter-spacing: .05em; text-transform: uppercase; color: var(--texto);
+  border-bottom: 1px solid var(--rejilla); padding-bottom: 4px; }
+.tarjeta h2, .guia h2 { border-bottom: 0; }
+.pestanas [role="tab"] { font-size: .86rem; letter-spacing: .02em; }
+.grupos-nav button { font-family: var(--mono); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; border-radius: var(--radio); }
+input, select, textarea { border-color: var(--borde-control); }
+a { text-underline-offset: 2px; }
+th { font-family: var(--mono); font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; }
+th, td { padding: 5px 9px; }
+tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--superficie-2) 45%, transparent); }
+tbody tr:hover td { background: var(--superficie-2); }
+.kpi .etiqueta { font-family: var(--mono); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
+.boton { border-radius: var(--radio); }
+.boton--secundario { border-color: var(--borde-control); }
+.guia { border-left-color: var(--acento-grafico); border-radius: var(--radio); }
+.widget-tv { border-radius: var(--radio); background: var(--superficie); }
+.nav-global__reloj { font-family: var(--mono); font-size: .78rem; color: var(--texto-2); white-space: nowrap; letter-spacing: .03em; }
+.nav-global__reloj b { color: var(--texto); font-weight: 650; }
+.cinta-global { display: block; width: 100%; height: 76px; border: 0; border-bottom: 1px solid var(--borde); background: var(--superficie); }
+.sin-dato { font-family: var(--mono); font-size: .8rem; color: var(--sin-datos); }
+* { scrollbar-width: thin; scrollbar-color: var(--borde) transparent; }
+::-webkit-scrollbar { width: 8px; height: 8px; }
