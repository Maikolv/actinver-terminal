+/* ---------- Capa de terminal profesional (compartida por todas las áreas) ----------
+   Inspirada en la paleta de OpenTerminal (ErTasselli, MIT): fondo casi negro, acento ámbar para títulos y datos en
+   monoespaciado. El logo conserva --marca. Contraste ámbar: oscuro 9.8:1 sobre #0b0c0e; claro 5.1:1 sobre #f6f5f2. */
+:root { --ambar: #9a5700; --radio: 4px; --rejilla: color-mix(in srgb, var(--borde) 55%, transparent); }
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) { --fondo: #0b0c0e; --superficie: #111317; --superficie-2: #181b20; --borde: #272b32; --ambar: #ff9f1a; }
+}
+:root[data-theme="dark"] { --fondo: #0b0c0e; --superficie: #111317; --superficie-2: #181b20; --borde: #272b32; --ambar: #ff9f1a; }
+
+main h1, .cuaderno-intro h1 { font-family: var(--mono); font-size: 1.15rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ambar);
+  border-left: 3px solid var(--ambar); padding-left: 10px; }
+main h2 { font-family: var(--mono); font-size: .9rem; letter-spacing: .05em; text-transform: uppercase; color: var(--texto);
+  border-bottom: 1px solid var(--rejilla); padding-bottom: 4px; }
+.tarjeta h2, .guia h2 { border-bottom: 0; }
+.pestanas [role="tab"] { font-size: .88rem; letter-spacing: .02em; }
+.pestanas [role="tab"][aria-selected="true"] { border-bottom-color: var(--ambar); color: var(--ambar); }
+.grupos-nav button { font-family: var(--mono); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; border-radius: var(--radio); }
+th { font-family: var(--mono); font-size: .74rem; letter-spacing: .05em; text-transform: uppercase; }
+th, td { padding: 6px 10px; }
+tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--superficie-2) 45%, transparent); }
+tbody tr:hover td { background: var(--superficie-2); }
+.kpi .etiqueta { font-family: var(--mono); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
+.boton { border-radius: var(--radio); }
+.guia { border-left-color: var(--ambar); border-radius: var(--radio); }
+.widget-tv { border-radius: var(--radio); background: var(--superficie); }
+.nav-global__reloj { font-family: var(--mono); font-size: .78rem; color: var(--texto-2); white-space: nowrap; letter-spacing: .03em; }
+.nav-global__reloj b { color: var(--ambar); font-weight: 600; }
+.cinta-global { display: block; width: 100%; height: 76px; border: 0; border-bottom: 1px solid var(--borde); background: var(--superficie); }
+* { scrollbar-width: thin; scrollbar-color: var(--borde) transparent; }
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { background: var(--borde); }
+::-webkit-scrollbar-thumb:hover { background: var(--ambar); }
+@media print { main h1 { color: #000; border-color: #000; } }
